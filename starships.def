# Use the official Python image as the base image
Bootstrap: docker
From: python:3.10-slim


%files
    ./test.py /test/test.py




%post

    # sudo apt install -y gcc g++ gfortran libopenblas-dev liblapack-dev pkg-config
    apt-get update && apt-get install -y bash emacs git gcc g++ make libhdf5-dev libnetcdf-dev libomp-dev libopenmpi-dev openmpi-bin
    # Set the working directory in the container
    mkdir /build && cd /build

    # Install the dependencies
    # scipy 1.11.2 is required for 'scipy.signal.gaussian'
    # matplotlib 3.7.2 is required for 'matplotlib.tri.triangulation'
    export HDF5_DIR=/usr/include/hdf5 && \
        pip install numpy==1.23 && \
        pip install netcdf4 petitRADTRANS==2.4.9 scipy==1.11.2 matplotlib==3.7.2 \
            ipython ipykernel jupyterlab jupyter 



    # Note: exofile is required to run the starships code.
    # v0.2.2 from pypy is bugged and records the version number as 0.0.0 which throws an error
    # when trying to install starships
    # Installing from the git repository fixes this issue.
    git clone --depth 1 --branch v0.2.2 https://github.com/AntoineDarveau/exofile.git && \
        cd exofile &&  pip install .

    # Note: 'python setup.py install' is required to correctly install batman-package v2.4.8. 
    # "pip install ." will work with newer versions (2.5) of batman-package. 
    git clone -b developolivia --single-branch https://github.com/orpereira/starships.git && \
        cd starships && python setup.py install 

        
    # RUN pip install --upgrade pip && pip install --upgrade setuptools


    # RUN python setup.py install
    # pip install --no-cache-dir -r requirements.txt && pip install mpi4py h5py netcdf4
        
    pip install ipython && mkdir -p /starships/data



%environment
    export HDF5_DIR=/usr/include/hdf5
    export pRT_input_data_path=/starships/data
    

%runscript
    bash


